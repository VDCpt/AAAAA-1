# UNIFED-PROBATUM | server-auth — Template de variáveis de ambiente
# Copiar para ".env" e PREENCHER com valores reais. NUNCA fazer commit de ".env".

USERNAME_EXPECTED=Analista

# PASSWORD_HASH_EXPECTED: hash SHA-256 (64 caracteres hex, lowercase) da
# password real escolhida. NUNCA escrever a password em texto limpo neste
# ficheiro nem em qualquer ficheiro versionado.
#
# Para gerar o hash da SUA password real, correr (não usar o exemplo abaixo
# em produção):
#
#   node generate-hash.js
#
# (o script pede a password de forma interativa, sem a mostrar no ecrã, e
# sem a guardar em lado nenhum nem a passar como argumento de linha de
# comandos — argumentos CLI ficam visíveis no histórico do shell e em
# `ps aux` durante a execução, pelo que NUNCA se deve gerar o hash com
# `node -e "...password..."` diretamente.)
#
# Exemplo de FORMATO esperado (hash de "changeme-exemplo-NAO-USAR", apenas
# para ilustrar o formato — 64 hex chars):
PASSWORD_HASH_EXPECTED=2f3c1e1a0b6f8d4e5c7a9b2d3e4f5061728394a5b6c7d8e9f0a1b2c3d4e5f607

PORT=8443
NODE_ENV=production

# Caminhos para certificado/chave TLS (HTTPS obrigatório — ver server.js)
TLS_CERT_PATH=./certs/server.crt
TLS_KEY_PATH=./certs/server.key
